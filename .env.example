# ── API Keys ──────────────────────────────────────────
AQICN_API_KEY=your_aqicn_token_here
OPENWEATHER_API_KEY=your_openweather_key_here

# ── City Configuration ────────────────────────────────
CITY_NAME=Karachi
CITY_LAT=24.8607
CITY_LON=67.0011
AQICN_CITY_SLUG=karachi

# ── Hopsworks Feature Store ───────────────────────────
HOPSWORKS_API_KEY=your_hopsworks_key_here
HOPSWORKS_PROJECT=pearls_aqi

# ── Flask API ─────────────────────────────────────────
FLASK_PORT=5000
FLASK_DEBUG=False

# ── Model Settings ─────────────────────────────────────
MODEL_VERSION=latest
FORECAST_DAYS=3

# ── Alerts ────────────────────────────────────────────
ALERT_AQI_THRESHOLD=150
